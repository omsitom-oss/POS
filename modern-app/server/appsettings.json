{
  "Database": {
    "Provider": "SQLite",
    "SqliteConnectionString": "Data Source=data/elite-pos.db"
  },
  "Auth": {
    "SessionIdleMinutes": 120,
    "SessionLifetimeMinutes": 720,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
